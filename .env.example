DATABASE_URL=sqlite:///./cv_platform.sqlite3
STORAGE_ROOT=storage
TEMP_ROOT=temp
# Add the public frontend origin when using Cloudflare Tunnel, for example:
# CORS_ORIGINS=https://app.example.com,http://127.0.0.1:5173,http://localhost:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
AUTH_JWT_SECRET=replace-with-a-long-random-secret-before-deployment
AUTH_ACCESS_TOKEN_MINUTES=30
AUTH_REFRESH_TOKEN_DAYS=14
AUTH_ALLOW_LEGACY_ACCOUNT_CLAIM=false

# Frontend and Vite server settings are read from this same root .env file.
# /api keeps browser requests on the frontend origin; Vite proxies them to API_PROXY_TARGET.
# Full API URLs separated by commas are still supported for a separate public API hostname.
VITE_API_BASE_URL=/api
API_PROXY_TARGET=http://127.0.0.1:8000
# Public tunnel hostname only, without https:// or a path.
# Examples: VITE_ALLOWED_HOSTS=example.ngrok-free.app or VITE_ALLOWED_HOSTS=app.example.com
VITE_ALLOWED_HOSTS=
